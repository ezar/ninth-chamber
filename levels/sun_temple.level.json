    {
      "when": "slot_sun.filled",
      "do": ["sun_door.open", "camera.focus sun_door 3s", "sfx rumble"]
    },
    {
      "when": "z_rays.entered",
      "do": ["checkpoint", "music calm", "hint hint.temple.rays"]
    },
    {
      "when": "disc_north.lit and disc_south.lit",
      "do": ["gate_rays.open", "camera.focus gate_rays 3s", "sfx rumble"]
    },
    {
      "when": "z_rays_gate.entered",
      "do": ["checkpoint"]
    },
    {
      "when": "lever_bridge.used",
      "do": ["bridge.open 3s"],
      "once": false
    },
    {
      "when": "guardian.awake",
      "do": ["gate_rays.close", "camera.focus guardian 2s", "music boss", "hint hint.temple.guardian"]
    },
    {
      "when": "guardian.phase2",
      "do": ["checkpoint", "hint hint.temple.guardian2"]
    },
    {
      "when": "guardian.defeated",
      "do": [
        "gate_sanctum.open",
        "gate_rays.open",
        "camera.focus gate_sanctum 3s",
        "music calm",
        "music hall"
      ]
    },
    {
      "when": "z_sanctuary.entered",
      "do": ["checkpoint", "music relic"]
    },
    {
      "when": "sun_disc.taken",
      "do": ["camera.focus sun_disc 3s", "music fanfare", "wait 3s", "level.end"]
    }
  ]
}
