    },
    {
      "when": "z_flutes.entered",
      "do": ["checkpoint", "hint hint.wind.flutes", "music tension"]
    },
    {
      "when": "lever_head.used",
      "do": ["gust_head.toggle"],
      "once": false
    },
    {
      "when": "lever_tail.used",
      "do": ["gust_tail.toggle"],
      "once": false
    },
    {
      "when": "lever_hidden.used",
      "do": ["gust_hidden.off", "door_hidden.open", "camera.focus door_hidden 2s"]
    },
    {
      "when": "z_nest.entered",
      "do": ["checkpoint", "hint hint.wind.birds", "music tension"]
    },
    {
      "when": "z_traverse.entered",
      "do": ["checkpoint", "hint hint.wind.traverse"]
    },
    {
      "when": "z_rope.entered",
      "do": ["checkpoint", "hint hint.wind.rope"]
    },
    {
      "when": "rope_call.pulled",
      "do": ["cw_rope.goto 1"],
      "once": false
    },
    {
      "when": "cw_rope.at1",
      "do": ["wait 3s", "cw_rope.goto 0"],
      "once": false
    },
    {
      "when": "z_great.entered",
      "do": ["checkpoint", "hint hint.wind.great", "music vista"]
    },
    {
      "when": "z_great_top.entered",
      "do": ["checkpoint"]
    },
    {
      "when": "z_storm.entered",
      "do": ["checkpoint", "hint hint.wind.storm", "music tension"]
    },
    {
      "when": "z_storm_c.entered",
      "do": ["checkpoint"]
    },
    {
      "when": "z_storm_d.entered",
      "do": ["checkpoint"]
    },
    {
      "when": "z_summit.entered",
      "do": ["checkpoint", "music relic", "hint hint.wind.summit"]
    },
    {
      "when": "wind_shell.taken",
      "do": ["camera.focus wind_shell 3s", "music fanfare", "wait 3s", "level.end"]
    }
  ]
}
