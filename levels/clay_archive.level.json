  "logic": [
    {
      "when": "z_start.entered",
      "do": ["hint hint.archive.start", "music vista"]
    },
    {
      "when": "z_reading.entered",
      "do": ["checkpoint", "hint hint.archive.lock", "music calm"]
    },
    {
      "when": "lock_reading.set",
      "do": ["door_reading.open", "camera.focus door_reading 2s", "sfx rumble"]
    },
    {
      "when": "torch1.taken",
      "do": ["hint hint.torch"]
    },
    {
      "when": "z_stacks.entered",
      "do": ["checkpoint", "hint hint.archive.shelves"]
    },
    {
      "when": "z_gallery.entered",
      "do": ["checkpoint", "hint hint.archive.darts", "music tension"]
    },
    {
      "when": "z_gallery.entered and not torchLit",
      "do": ["hint hint.dark"]
    },
    {
      "when": "z_kiln.entered",
      "do": ["checkpoint", "hint hint.archive.kiln", "music calm"]
    },
    {
      "when": "kiln_plate.pressed",
      "do": ["kiln_mouth.open"],
      "once": false
    },
    {
      "when": "not kiln_plate.pressed",
      "do": ["kiln_mouth.close"],
      "once": false
    },
    {
      "when": "kiln_plate.pressed",
      "do": ["camera.focus kiln_mouth 2s"]
    },
    {
      "when": "lock_first.set and lock_scribe.set",
      "do": ["door_kiln.open", "camera.focus door_kiln 2s", "sfx rumble"]
    },
    {
      "when": "z_scriptorium.entered",
      "do": ["checkpoint", "music vista"]
    },
    {
      "when": "z_index.entered",
      "do": ["checkpoint", "hint hint.archive.index"]
    },
    {
      "when": "lock_flood.set and lock_fire.set",
      "do": ["door_index.open", "camera.focus door_index 2s", "sfx rumble"]
    },
    {
      "when": "z_canal.entered",
      "do": ["checkpoint", "hint hint.archive.canal", "camera.focus flood_gate 3s"]
    },
    {
      "when": "z_tamrit.entered",
      "do": ["checkpoint", "music boss", "hint hint.archive.tamrit"]
    },
    {
      "when": "lever_flood.used",
      "do": ["flood_gate.toggle", "camera.focus tamrit 3s", "sfx rumble"]
    },
    {
      "when": "tamrit.dead",
      "do": ["door_tamrit.open", "camera.focus door_tamrit 3s", "music calm", "music solved"]
    },
    {
      "when": "z_name.entered",
      "do": ["checkpoint", "music relic", "hint hint.archive.name"]
    },
    {
      "when": "lock_look.set and lock_when.set and lock_way.set",
      "do": ["gate_name.open", "camera.focus gate_name 3s", "sfx rumble"]
    },
    {
      "when": "name_tablet.taken",
      "do": ["camera.focus name_tablet 3s", "music fanfare", "wait 3s", "level.end"]
    }
  ]
}
