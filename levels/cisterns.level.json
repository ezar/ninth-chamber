  "logic": [
    {
      "when": "z_start.entered",
      "do": ["hint hint.cisterns.start"]
    },
    {
      "when": "z_camp.entered",
      "do": ["checkpoint", "hint hint.cisterns.wade"]
    },
    {
      "when": "z_swim.entered",
      "do": ["music vista", "hint hint.cisterns.swim"]
    },
    {
      "when": "z_dive.entered",
      "do": ["checkpoint", "music tension", "hint hint.cisterns.dive"]
    },
    {
      "when": "z_air.entered",
      "do": ["hint hint.cisterns.air"]
    },
    {
      "when": "z_sluice.entered",
      "do": ["checkpoint", "music calm", "music hall", "hint hint.cisterns.gate"]
    },
    {
      "when": "lever_gate_hi.used or lever_gate_lo.used",
      "do": ["sluice_gate.toggle", "camera.focus sluice_gate 3s", "sfx rumble"],
      "once": false
    },
    {
      "when": "sluice_gate.low",
      "do": ["hint hint.cisterns.fall"]
    },
    {
      "when": "lever_door.used",
      "do": ["door_sluice.open", "camera.focus door_sluice 3s"]
    },
    {
      "when": "z_aqueduct.entered",
      "do": ["checkpoint"]
    },
    {
      "when": "flares_cache.taken",
      "do": ["hint hint.cisterns.flares"]
    },
    {
      "when": "z_dark.entered",
      "do": ["checkpoint", "music tension", "hint hint.cisterns.braziers"]
    },
    {
      "when": "cold1.lit and cold2.lit and cold3.lit",
      "do": ["door_dark.open", "camera.focus door_dark 3s", "sfx rumble", "music calm", "music solved"]
    },
    {
      "when": "z_landing.entered",
      "do": ["checkpoint", "music calm"]
    },
    {
      "when": "z_tide.entered",
      "do": ["checkpoint", "music relic", "hint hint.cisterns.tide"]
    },
    {
      "when": "z_cave.entered",
      "do": ["checkpoint"]
    },
    {
      "when": "lever_tide.used",
      "do": ["tide_gate.toggle", "camera.focus tide_glass 4s", "sfx rumble"],
      "once": false
    },
    {
      "when": "tide_glass.taken",
      "do": ["camera.focus tide_glass 3s", "music fanfare", "wait 3s", "level.end"]
    }
  ]
}
