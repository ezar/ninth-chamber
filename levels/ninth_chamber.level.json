  "logic": [
    {
      "when": "z_start.entered",
      "do": ["hint hint.ninth.start", "music vista"]
    },
    {
      "when": "lever_pour.used",
      "do": ["pour_segment.pour", "sfx rumble"]
    },
    {
      "when": "lever_voice.used",
      "do": ["wind_voice.on", "hint hint.ninth.voice"]
    },
    {
      "when": "lever_moment.used",
      "do": ["ring_moment.turn"],
      "once": false
    },
    {
      "when": "disc_name.lit and pour_segment.cast and lever_voice.used and ring_moment.set",
      "do": ["tg_door.part", "camera.focus tg_door 3s", "music solved", "hint hint.ninth.seed"]
    },
    {
      "when": "z_eight.entered",
      "do": ["checkpoint", "hint hint.ninth.eight", "music calm"]
    },
    {
      "when": "z_dome.entered",
      "do": ["checkpoint", "hint hint.ninth.dome"]
    },
    {
      "when": "lever_dome.used",
      "do": ["ring_dome.turn"],
      "once": false
    },
    {
      "when": "lever_reset_dome.used",
      "do": ["block_dome.reset"],
      "once": false
    },
    {
      "when": "ring_dome.set and plate_moon.pressed",
      "do": ["door_dome.open", "camera.focus door_dome 2s"]
    },
    {
      "when": "z_wind.entered",
      "do": ["hint hint.ninth.wind"]
    },
    {
      "when": "z_bridge.entered",
      "do": ["checkpoint", "hint hint.ninth.gust"]
    },
    {
      "when": "z_bronze.entered",
      "do": ["checkpoint", "hint hint.ninth.bronze"]
    },
    {
      "when": "lever_bronze.used",
      "do": ["pour_bridge.pour", "sfx rumble"]
    },
    {
      "when": "z_fire.entered",
      "do": ["checkpoint", "hint hint.ninth.fire"]
    },
    {
      "when": "z_roots.entered",
      "do": ["checkpoint", "hint hint.ninth.roots"]
    },
    {
      "when": "z_glyphs.entered",
      "do": ["checkpoint", "hint hint.ninth.glyphs"]
    },
    {
      "when": "lock_glyphs.set and lock_star.set",
      "do": ["door_glyphs.open", "camera.focus door_glyphs 2s", "sfx rumble"]
    },
    {
      "when": "z_mirrors.entered",
      "do": ["timer.start 240s", "checkpoint", "music tension", "hint hint.ninth.timer"]
    },
    {
      "when": "disc_door.lit",
      "do": ["door_mirrors.open", "camera.focus door_mirrors 2s", "sfx rumble"]
    },
    {
      "when": "disc_niche.lit",
      "do": ["door_niche.open", "sfx rumble"]
    },
    {
      "when": "z_blades.entered",
      "do": ["hint hint.ninth.blades"]
    },
    {
      "when": "z_water.entered",
      "do": ["hint hint.ninth.water"]
    },
    {
      "when": "lever_water.used",
      "do": ["gate_water.raise", "camera.focus gate_water 2s", "sfx rumble"]
    },
    {
      "when": "z_sand.entered",
      "do": ["timer.add 60s", "checkpoint", "music tension", "hint hint.ninth.sand"]
    },
    {
      "when": "plate_sand.pressed",
      "do": ["door_sand.open", "camera.focus door_sand 2s", "sfx rumble"]
    },
    {
      "when": "z_seal.entered",
      "do": ["timer.stop", "checkpoint", "music relic", "door_leave.open", "hint hint.ninth.seal"]
    },
    {
      "when": "seal_ninth.used and not z_leave.entered",
      "do": ["camera.focus seal 3s", "music fanfare", "wait 3s", "level.end keeper"]
    },
    {
      "when": "z_leave.entered and not seal_ninth.used",
      "do": ["music calm", "wait 2s", "level.end blank"]
    }
  ]
}
