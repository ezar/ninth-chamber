  "logic": [
    {
      "when": "z_start.entered",
      "do": ["hint hint.obs.start", "music vista"]
    },
    {
      "when": "z_gallery.entered",
      "do": ["checkpoint", "hint hint.obs.name", "music calm"]
    },
    {
      "when": "lock_eye.set and lock_star.set and lock_mountain.set",
      "do": ["door_gallery.open", "camera.focus door_gallery 2s"]
    },
    {
      "when": "z_first.entered",
      "do": ["checkpoint", "hint hint.obs.ring"]
    },
    {
      "when": "lever_first.used",
      "do": ["ring_first.turn"],
      "once": false
    },
    {
      "when": "ring_first.at4",
      "do": ["door_niche.open", "camera.focus door_niche 2s"]
    },
    {
      "when": "ring_first.set",
      "do": ["door_first.open", "camera.focus door_first 2s"]
    },
    {
      "when": "z_moons.entered",
      "do": ["checkpoint", "hint hint.obs.moons"]
    },
    {
      "when": "plate_new.pressed",
      "do": ["door_moons.open", "camera.focus door_moons 2s"]
    },
    {
      "when": "lever_reset_moons.used",
      "do": ["block_moons.reset"],
      "once": false
    },
    {
      "when": "z_horizon.entered",
      "do": ["checkpoint", "hint hint.obs.horizon"]
    },
    {
      "when": "disc_horizon.lit",
      "do": ["door_horizon.open", "camera.focus door_horizon 2s"]
    },
    {
      "when": "z_stairs.entered",
      "do": ["checkpoint", "music tension"]
    },
    {
      "when": "z_dome.entered",
      "do": ["checkpoint", "hint hint.obs.dome", "music vista"]
    },
    {
      "when": "z_arena.entered",
      "do": ["checkpoint", "camera.focus anzur 3s", "music boss", "hint hint.obs.anzur"]
    },
    {
      "when": "lever_sky.used",
      "do": ["ring_sky.turn"],
      "once": false
    },
    {
      "when": "lever_moon.used",
      "do": ["ring_moon.turn"],
      "once": false
    },
    {
      "when": "lever_horizon.used",
      "do": ["ring_horizon.turn"],
      "once": false
    },
    {
      "when": "ring_sky.set",
      "do": ["anzur.advance", "checkpoint"]
    },
    {
      "when": "ring_moon.set",
      "do": ["anzur.advance", "checkpoint"]
    },
    {
      "when": "ring_sky.set and ring_moon.set and ring_horizon.set",
      "do": ["oculus_arena.on", "camera.focus oculus_arena 2s", "hint hint.obs.light"]
    },
    {
      "when": "anzur.phase2",
      "do": ["gate_seat.open", "hint hint.obs.floor"]
    },
    {
      "when": "anzur.defeated",
      "do": ["door_arena.open", "camera.focus door_arena 3s", "music calm", "music solved"]
    },
    {
      "when": "z_oculus.entered",
      "do": ["checkpoint", "hint hint.obs.oculus"]
    },
    {
      "when": "z_astrolabe.entered",
      "do": ["checkpoint", "music relic", "hint hint.obs.astrolabe"]
    },
    {
      "when": "astrolabe.taken",
      "do": ["camera.focus astrolabe 3s", "music fanfare", "wait 3s", "level.end"]
    }
  ]
}
