  "logic": [
    { "when": "z_start.entered", "do": ["hint hint.move"] },
    { "when": "z_terrace.entered", "do": ["hint hint.grab"] },
    { "when": "z_hall.entered", "do": ["checkpoint", "music hall"] },
    { "when": "z_block.entered", "do": ["hint hint.push"] },
    { "when": "lever1.used", "do": ["door1.open", "camera.focus door1 3s", "sfx rumble"] },
    { "when": "z_gallery.entered", "do": ["checkpoint"] },
    { "when": "z_pit.entered", "do": ["hint hint.runningJump"] },
    { "when": "z_relic.entered", "do": ["checkpoint", "music relic"] },
    { "when": "heart.taken", "do": ["camera.focus heart 3s", "music fanfare", "wait 3s", "level.end"] },

    { "when": "z_plate_hall.entered", "do": ["checkpoint", "hint hint.plate"] },
    { "when": "plate1.pressed", "do": ["gate1.open"], "once": false },
    { "when": "not plate1.pressed", "do": ["gate1.close"], "once": false },
    { "when": "plate1.pressed", "do": ["camera.focus gate1 2s"] },
    { "when": "gate1.open", "do": ["flag set gate1_seen"] },
    { "when": "gate1_seen and not plate1.pressed", "do": ["hint hint.weight"] },

    { "when": "z_hourglass.entered", "do": ["checkpoint"] },
    { "when": "z_hourglass_plate.entered", "do": ["hint hint.runningJump"] },
    { "when": "plate2.pressed", "do": ["gate2.open"], "once": false },
    { "when": "gate2.open and not plate2.pressed", "do": ["gate2.open 12s"], "once": false },
    { "when": "plate2.pressed", "do": ["camera.focus gate2 2s", "sfx rumble"] },
    { "when": "gate2.open and not plate2.pressed", "do": ["hint hint.timer"] },

    { "when": "z_well.entered", "do": ["checkpoint"] },
    { "when": "z_well_gap.entered", "do": ["hint hint.standingJump"] },
    { "when": "z_well_top.entered", "do": ["checkpoint", "music hall"] },

    { "when": "z_causeway.entered", "do": ["checkpoint", "hint hint.fill"] },
    { "when": "z_far_side.entered", "do": ["checkpoint"] },

    { "when": "z_scales.entered", "do": ["checkpoint", "hint hint.scales"] },
    { "when": "z_shelf.entered", "do": ["hint hint.reset"] },
    { "when": "plate_a.pressed and plate_b.pressed", "do": ["gate_scales.open"], "once": false },
    { "when": "not (plate_a.pressed and plate_b.pressed)", "do": ["gate_scales.close"], "once": false },
    { "when": "plate_a.pressed and plate_b.pressed", "do": ["camera.focus gate_scales 3s", "sfx rumble"] },
    {
      "when": "lever_reset.used",
      "do": ["block_a.reset", "block_b.reset", "camera.focus block_b 2s"],
      "once": false
    },

    { "when": "z_descent.entered", "do": ["checkpoint", "hint hint.dropHang"] },
    { "when": "z_ledge.entered", "do": ["checkpoint"] }
  ]
}
