    },
    {
      "when": "z_bellows.entered",
      "do": ["checkpoint", "hint hint.forge.bellows"]
    },
    {
      "when": "plate_bellows.pressed",
      "do": ["forge_main.light", "sfx rumble"]
    },
    {
      "when": "forge_main.lit",
      "do": ["door_bellows.open", "camera.focus door_bellows 2s"]
    },
    {
      "when": "forge_mould.lit",
      "do": ["door_mould.open", "camera.focus door_mould 2s"]
    },
    {
      "when": "lever_reset_bellows.used",
      "do": ["bellows.reset"],
      "once": false
    },
    {
      "when": "z_canal.entered",
