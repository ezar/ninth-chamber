    {
      "when": "z_workshop.entered",
      "do": ["checkpoint", "music calm"]
    },
    {
      "when": "founder_key.taken",
      "do": [
        "door_alcove.open",
        "a1.alert",
        "camera.focus a1 2s",
        "music tension",
        "hint hint.forge.automaton"
      ]
    },
    {
      "when": "z_quench.entered",
      "do": ["checkpoint", "hint hint.forge.quench"]
    },
    {
      "when": "lever_sluice.used",
      "do": ["quench_gate.toggle", "sfx rumble"],
      "once": false
    },
    {
      "when": "a1.dead",
      "do": ["door_quench.open", "camera.focus door_quench 2s", "music solved"]
    },
    {
      "when": "z_furnaces.entered",
      "do": ["checkpoint", "hint hint.forge.heat", "music tension"]
    },
    {
      "when": "z_bridge.entered",
      "do": ["checkpoint", "hint hint.forge.timing"]
    },
    {
      "when": "z_casting.entered",
      "do": ["checkpoint", "music boss", "hint hint.forge.bazur"]
    },
    {
      "when": "lever_casting.used",
      "do": ["pour_gutter.pour", "sfx rumble"],
      "once": false
    },
    {
      "when": "bazur.phase2",
      "do": ["pour_side_a.start", "pour_side_b.start", "hint hint.forge.bazur2"]
    },
    {
      "when": "bazur.defeated",
      "do": [
        "pour_side_a.stop",
        "pour_side_b.stop",
        "door_casting.open",
        "camera.focus door_casting 3s",
        "music calm",
        "music solved"
      ]
    },
    {
      "when": "z_mould.entered",
      "do": ["checkpoint", "music relic", "hint hint.forge.mould"]
    },
    {
      "when": "slot_mould.filled",
      "do": ["pour_mould.pour", "sfx rumble"]
    },
    {
      "when": "pour_mould.cast",
      "do": ["gate_mould.open", "camera.focus gate_mould 3s"]
    },
    {
      "when": "ninth_segment.taken",
      "do": ["camera.focus ninth_segment 3s", "music fanfare", "wait 3s", "level.end"]
    }
  ]
}
