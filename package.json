{
  "name": "ninth-chamber",
  "private": true,
  "version": "0.9.14",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm validate:levels && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "replay:update": "tsx scripts/replay-update.ts",
    "anim:build": "tsx scripts/anim/build-clips.ts",
    "bench": "tsx scripts/perf/bench.ts",
    "loadtime": "tsx scripts/perf/loadtime.ts",
    "textures:ktx2": "tsx scripts/textures/ktx2.ts",
    "smoke": "tsx scripts/browser/smoke.ts",
    "offline": "tsx scripts/browser/offline.ts",
    "shots": "tsx scripts/browser/shots.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
